# URL pública del deploy (la usa el QR del tríptico)
NEXT_PUBLIC_SITE_URL=https://tu-proyecto.vercel.app

# ─────────────────────────────────────────────────────────────
#  Configuración de "Bebé Abrigado" — copiá este archivo como .env.local
# ─────────────────────────────────────────────────────────────

# --- Supabase (base de datos del foro) ---
# Si están vacías, la app funciona en MODO DEMO guardando en /.data/consultas.json
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio (service_role). Solo se usa en el servidor. NO la expongas al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email SMTP (aviso interno de nuevas consultas) ---
# Si están vacías, el aviso se muestra por consola en vez de enviarse.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# A dónde llegan las consultas (mail interno) y desde qué remitente
MAIL_TO=serranojo88@gmail.com
MAIL_FROM="Cuidados en internación conjunta <no-reply@sanatoriomodelosa.com.ar>"

# --- Panel de administración ---
ADMIN_PASSWORD=cambiame-por-favor
